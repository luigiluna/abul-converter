# Copie para .env e preencha. O .env nunca vai para o git.
# Variáveis de ambiente reais têm prioridade sobre este arquivo.

# ARL da sua conta Deezer (cookie "arl" em deezer.com). Padrão para todos os usuários.
DEFAULT_ARL=

# Chave que cifra os ARLs próprios salvos em data/users/. Obrigatória em prod.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Trocar a chave invalida os ARLs próprios salvos (os usuários voltam para o DEFAULT_ARL).
APP_SECRET_KEY=

# prod | dev. Em dev a APP_SECRET_KEY pode ficar vazia e DEV_USER substitui o login do Caddy.
APP_ENV=prod
# DEV_USER=voce

# Pasta dos dados persistentes (usuários, cache, jobs). Padrão: <raiz>/data
# DATA_DIR=

# Downloads simultâneos no servidor inteiro / máximo que cada usuário pode escolher.
MAX_PARALLEL_DOWNLOADS=4
MAX_USER_CONCURRENCY=3
# Horas até apagar os arquivos de um job; recusa downloads com menos disco livre que isso (GB).
JOB_TTL_HOURS=6
MIN_FREE_GB=2
