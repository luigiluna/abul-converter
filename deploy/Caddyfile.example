# Copie para deploy/Caddyfile. O Caddy só faz HTTPS; o login é do app (docs/ARCHITECTURE.md §7.1).
#
# Criar um usuário ou trocar a senha (nome: minúsculas, dígitos, _ ou -, até 32):
#   docker compose exec -u app app python -m app.passwd <nome>
#
# Depois de editar este arquivo: docker compose exec -w /etc/caddy caddy caddy reload
#
# Troque o domínio pelo seu (ex.: subdomínio DuckDNS apontando para o IP público da VM).
# Com as portas 80 e 443 liberadas, o Caddy emite o certificado HTTPS sozinho.

musica.seudominio.duckdns.org {
	reverse_proxy app:8000
}

# Teste local sem domínio (HTTP puro na porta 80): comente o bloco acima e use este.
# O cookie de sessão é "Secure" em APP_ENV=prod, então o login só funciona com APP_ENV=dev.
#
# :80 {
# 	reverse_proxy app:8000
# }
